<Window x:Class="NetMonitor.ProxyTemplateNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar plantilla" Width="430" Height="210" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GroundBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource ChartFace}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GUARDAR PLANTILLA" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Ponle un nombre para encontrarla en el selector de plantillas."
                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Nombre" FontSize="14"/>
            <TextBox x:Name="NameBox" Style="{StaticResource RuleTextBox}" Margin="0,6,0,0" MaxLength="60"/>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource AlertBrush}"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource RuleButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource RuleButton}" IsDefault="True" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
