<Window x:Class="NetMonitor.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy" Width="660" Height="660" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GroundBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource ChartFace}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Typography.NumeralAlignment="Tabular">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionRule" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource RuleStrongBrush}"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10,0,10"/>
        </Style>
        <Style x:Key="Name" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource RuleTextBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Square dropdown that follows the chart palette instead of the system Aero look. -->
        <Style x:Key="ProxyCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource Ground2Brush}"
                                                BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}"
                                                  StrokeThickness="1.2" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBlock Text="Sin plantilla" Margin="8,0,26,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="-1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None" StaysOpen="False">
                                <Border Background="{DynamicResource Ground2Brush}" BorderBrush="{DynamicResource RuleStrongBrush}"
                                        BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240" SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProxyComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RuleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Down3Brush}"/>
                                <Setter Property="Foreground" Value="#0B1F33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PROXY" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Proxy de Windows y variables HTTP_PROXY / HTTPS_PROXY del usuario actual."
                       Style="{StaticResource Note}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,16" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="PLANTILLA" Style="{StaticResource Section}"/>
                <Rectangle Style="{StaticResource SectionRule}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TemplateCombo" Style="{StaticResource ProxyCombo}"
                              ItemContainerStyle="{StaticResource ProxyComboItem}"
                              SelectionChanged="OnTemplateChanged" AutomationProperties.Name="Plantilla de proxy">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource RuleButton}" Content="Guardar como plantilla…" Padding="10,5"
                                Click="OnSaveTemplateClick" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource RuleButton}" Content="Eliminar" Padding="10,5"
                                Click="OnDeleteTemplateClick"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Elige una plantilla guardada para cargar sus valores. Después pulsa Guardar para aplicarla al sistema."
                           Style="{StaticResource Note}" Margin="0,6,0,0"/>

                <TextBlock Text="PROXY DEL SISTEMA" Style="{StaticResource Section}" Margin="0,28,0,10"/>
                <Rectangle Style="{StaticResource SectionRule}"/>

                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="SystemProxySwitch" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="Usar proxy del sistema" Style="{StaticResource Name}"/>
                            <TextBlock Text="Activa ProxyEnable en la configuración de Internet de Windows." Style="{StaticResource Note}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Servidor" Style="{StaticResource Name}"/>
                    <TextBlock Text="host:puerto para todos, o http=host:puerto;https=host:puerto." Style="{StaticResource Note}"/>
                    <TextBox x:Name="ServerBox" Style="{StaticResource Field}"/>
                </StackPanel>

                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Excepciones (sin proxy)" Style="{StaticResource Name}"/>
                    <TextBlock Text="Separadas por punto y coma; por ejemplo localhost;127.*;10.*" Style="{StaticResource Note}"/>
                    <TextBox x:Name="BypassBox" Style="{StaticResource Field}"/>
                </StackPanel>

                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Script de configuración automática (PAC)" Style="{StaticResource Name}"/>
                    <TextBlock Text="URL del archivo .pac, por ejemplo http://servidor/proxy.pac" Style="{StaticResource Note}"/>
                    <TextBox x:Name="PacBox" Style="{StaticResource Field}"/>
                </StackPanel>

                <Border Style="{StaticResource Row}" Margin="0,10,0,0">
                    <CheckBox x:Name="AutoDetectSwitch" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="Detectar configuración automáticamente" Style="{StaticResource Name}"/>
                            <TextBlock Text="Equivale a AutoDetect (WPAD)." Style="{StaticResource Note}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <TextBlock Text="VARIABLES DE ENTORNO" Style="{StaticResource Section}" Margin="0,28,0,10"/>
                <Rectangle Style="{StaticResource SectionRule}"/>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="HTTP_PROXY" Style="{StaticResource Name}"/>
                    <TextBlock Text="Se guarda en el usuario actual; vacío la elimina." Style="{StaticResource Note}"/>
                    <TextBox x:Name="HttpProxyBox" Style="{StaticResource Field}" FontFamily="{StaticResource LogFace}"/>
                </StackPanel>

                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="HTTPS_PROXY" Style="{StaticResource Name}"/>
                    <TextBlock Text="Misma notación que HTTP_PROXY." Style="{StaticResource Note}"/>
                    <TextBox x:Name="HttpsProxyBox" Style="{StaticResource Field}" FontFamily="{StaticResource LogFace}"/>
                </StackPanel>

                <TextBlock Text="Los programas abiertos pueden necesitar reiniciarse para tomar los cambios."
                           Style="{StaticResource Note}" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource RuleButton}" Content="Cerrar" Margin="0,0,8,0" Click="OnCloseClick"/>
                <Button Style="{StaticResource RuleButton}" Content="Guardar" Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource AlertBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,16,0"/>
        </DockPanel>
    </Grid>
</Window>
