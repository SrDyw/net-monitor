<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:NetMonitor.Services">

    <FontFamily x:Key="ChartFace">Bahnschrift</FontFamily>

    <!-- Keyboard focus: a one-pixel ink rule offset from the control, no radius. -->
    <Style x:Key="ChartFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>

    <!-- Ruled command button: one-pixel border, square, fills with ink on press. -->
    <Style x:Key="RuleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ChartFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource RuleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InkBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Range segment: radio buttons that read as one ruled strip; the chosen one is filled shoal. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ChartFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Box" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Down3Brush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Down3Brush}"/>
                            <Setter Property="Foreground" Value="#0B1F33"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status lamp: colour follows the link state. -->
    <Style x:Key="Lamp" TargetType="Rectangle">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static s:LinkState.Connected}">
                <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static s:LinkState.HighLatency}">
                <Setter Property="Fill" Value="{DynamicResource AlertBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static s:LinkState.NoInternet}">
                <Setter Property="Fill" Value="{DynamicResource AlertBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static s:LinkState.NoNetwork}">
                <Setter Property="Fill" Value="{DynamicResource LandBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Drawn direction marks (no glyphs): a stem with a chevron. -->
    <Geometry x:Key="DownMark">M5,0 L5,10 M1,6 L5,10 L9,6</Geometry>
    <Geometry x:Key="UpMark">M5,10 L5,0 M1,4 L5,0 L9,4</Geometry>

    <Geometry x:Key="BackMark">M6,0 L1,5 L6,10</Geometry>

    <!-- Pushpin: cap, flared base and needle, drawn as one silhouette. -->
    <Geometry x:Key="PinMark">M2,0 L8,0 L8,2 L7,2 L7,6 L9,8 L9,9 L6,9 L6,12 L4,12 L4,9 L1,9 L1,8 L3,6 L3,2 L2,2 Z</Geometry>

    <!-- On/off switch: a square ruled track; on, it fills shoal and the block slides right. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ChartFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" BorderThickness="1"
                                BorderBrush="{DynamicResource RuleStrongBrush}" Background="Transparent" SnapsToDevicePixels="True">
                            <Rectangle x:Name="Block" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                       Fill="{DynamicResource MutedBrush}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Down3Brush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Down3Brush}"/>
                            <Setter TargetName="Block" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Block" Property="Fill" Value="#0B1F33"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: a one-pixel rule, the filled run in shoal, a square ink block. -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle x:Name="Block" Width="12" Height="16" Fill="{DynamicResource InkBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Block" Property="Fill" Value="{DynamicResource Down3Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRun" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="{TemplateBinding Height}" Fill="{TemplateBinding Background}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RuleSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ChartFocus}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Height="20">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderRun}" Command="Slider.DecreaseLarge" Height="3" Background="{DynamicResource Down3Brush}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderRun}" Command="Slider.IncreaseLarge" Height="1" Background="{DynamicResource RuleStrongBrush}"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource SliderThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field: ruled box on the darker ground; the rule turns ink while editing. -->
    <Style x:Key="RuleTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Ground2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Down2Brush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AlertBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bar: a narrow rule-coloured block, no arrows. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle x:Name="Block" Width="4" Fill="{DynamicResource RuleStrongBrush}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Block" Property="Fill" Value="{DynamicResource MutedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data log lines: monospace because columns of bytes and addresses must align. -->
    <FontFamily x:Key="LogFace">Cascadia Mono, Consolas</FontFamily>

    <!-- Selectable list: one-pixel rule between rows, hover on the rule colour, selection filled shoal like a segment. -->
    <Style x:Key="PlateList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style x:Key="PlateListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ChartFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource RuleBrush}"
                            BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RuleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Down3Brush}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Down3Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Text inside a list row: deep-water ink when its row is selected (shoal fill), so it keeps contrast. -->
    <Style x:Key="RowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="#0B1F33"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RowMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="#1F4E79"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Ground2Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource ChartFace}"/>
    </Style>
</ResourceDictionary>
