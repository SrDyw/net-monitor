<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Day plate of the chart palette. Brush keys are shared with the other plate. -->
    <SolidColorBrush x:Key="GroundBrush" Color="#F5F9FB"/>
    <SolidColorBrush x:Key="Ground2Brush" Color="#E8F0F5"/>
    <SolidColorBrush x:Key="InkBrush" Color="#0B1F33"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#4C677D"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#D5E2EA"/>
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#9DB7CA"/>
    <SolidColorBrush x:Key="Down1Brush" Color="#1F4E79"/>
    <SolidColorBrush x:Key="Down2Brush" Color="#4F8DB5"/>
    <SolidColorBrush x:Key="Down3Brush" Color="#A8CFE0"/>
    <SolidColorBrush x:Key="Up1Brush" Color="#1F5A4F"/>
    <SolidColorBrush x:Key="Up2Brush" Color="#4E8F7C"/>
    <SolidColorBrush x:Key="Up3Brush" Color="#A9D4C0"/>
    <SolidColorBrush x:Key="LandBrush" Color="#E3D6A8"/>
    <SolidColorBrush x:Key="LandInkBrush" Color="#0B1F33"/>
    <SolidColorBrush x:Key="AlertBrush" Color="#C2187A"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1F8A5B"/>
    <SolidColorBrush x:Key="DatumBrush" Color="#0B1F33"/>
    <SolidColorBrush x:Key="PlateBrush" Color="#B30B1F33"/>
</ResourceDictionary>
