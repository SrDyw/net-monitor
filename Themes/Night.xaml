<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Night plate of the chart palette. Brush keys are shared with the other plate. -->
    <SolidColorBrush x:Key="GroundBrush" Color="#0B1F33"/>
    <SolidColorBrush x:Key="Ground2Brush" Color="#08192A"/>
    <SolidColorBrush x:Key="InkBrush" Color="#E6F0F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8FAABF"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#1C3851"/>
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#3A6489"/>
    <SolidColorBrush x:Key="Down1Brush" Color="#2F5F86"/>
    <SolidColorBrush x:Key="Down2Brush" Color="#4F8DB5"/>
    <SolidColorBrush x:Key="Down3Brush" Color="#A8CFE0"/>
    <SolidColorBrush x:Key="Up1Brush" Color="#2C5B55"/>
    <SolidColorBrush x:Key="Up2Brush" Color="#4E8F7C"/>
    <SolidColorBrush x:Key="Up3Brush" Color="#9CCBB5"/>
    <SolidColorBrush x:Key="LandBrush" Color="#E3D6A8"/>
    <SolidColorBrush x:Key="LandInkBrush" Color="#0B1F33"/>
    <SolidColorBrush x:Key="AlertBrush" Color="#EC6AAE"/>
    <SolidColorBrush x:Key="OkBrush" Color="#7FD1AE"/>
    <SolidColorBrush x:Key="DatumBrush" Color="#F2F7FA"/>
    <SolidColorBrush x:Key="PlateBrush" Color="#B30B1F33"/>
</ResourceDictionary>
