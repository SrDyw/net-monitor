<UserControl x:Class="NetMonitor.Controls.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NetMonitor.Controls">
    <!-- DataContext: ProcessesViewModel. Navigation commands come from the window's MonitorViewModel. -->
    <UserControl.Resources>
        <c:EqualsConverter x:Key="Equals"/>
        <BooleanToVisibilityConverter x:Key="Shown"/>

        <Style x:Key="DownMarkPath" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource DownMark}"/>
            <Setter Property="Stroke" Value="{DynamicResource Down2Brush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Stroke" Value="#0B1F33"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UpMarkPath" TargetType="Path" BasedOn="{StaticResource DownMarkPath}">
            <Setter Property="Data" Value="{StaticResource UpMark}"/>
            <Setter Property="Stroke" Value="{DynamicResource Up2Brush}"/>
        </Style>

        <!-- Pin: outline while free, filled while pinned; follows the row's selected inks. -->
        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ChartFocus}"/>
            <Setter Property="ToolTip" Value="Fijar arriba"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="Transparent" Padding="3" SnapsToDevicePixels="True">
                            <Path x:Name="Mark" Data="{StaticResource PinMark}" Width="10" Height="12"
                                  Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.1" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource RuleBrush}"/>
                                <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource InkBrush}"/>
                                <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource InkBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Mark" Property="Stroke" Value="#0B1F33"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Mark" Property="Fill" Value="#0B1F33"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="Soltar y volver al orden"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>
        <Style x:Key="WhenRunning" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenStopped" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnDestinations" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tab}" Value="Destinations">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnLog" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tab}" Value="Log">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,16,24,16">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button Style="{StaticResource RuleButton}" ToolTip="Esc" Padding="10,6,12,6"
                    Command="{Binding DataContext.ShowMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource BackMark}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Width="7" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Volver al monitor"/>
                </StackPanel>
            </Button>
            <TextBlock Text="PROCESOS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource WhenRunning}">
                <TextBlock Text="Rastreando el tráfico de todos los procesos" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Style="{StaticResource RuleButton}" Content="Detener inspección" Command="{Binding StopCommand}"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Process list -->
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource RuleTextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Buscar proceso"/>
                    <TextBlock Text="Buscar proceso" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="14" Foreground="{DynamicResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource RuleStrongBrush}"/>
                <ListBox x:Name="ProcessList" Style="{StaticResource PlateList}" ItemContainerStyle="{StaticResource PlateListItem}"
                         ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}"
                         AutomationProperties.Name="Procesos">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Style="{StaticResource PinToggle}"
                                              IsChecked="{Binding IsPinned, Mode=TwoWay}" VerticalAlignment="Top"
                                              AutomationProperties.Name="Fijar arriba"/>
                                <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                                                <Style.Triggers>
                                                    <!-- A pinned process that is not running reads as dead. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsOpen}" Value="False"/>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource RowMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Path Style="{StaticResource DownMarkPath}"/>
                                        <TextBlock Text="{Binding DownText}" FontSize="13" FontWeight="Bold" Style="{StaticResource RowText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Path Style="{StaticResource UpMarkPath}"/>
                                        <TextBlock Text="{Binding UpText}" Style="{StaticResource RowMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Inspector not running: why, and the way forward. -->
            <StackPanel Grid.Column="2" Style="{StaticResource WhenStopped}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <TextBlock Text="{Binding StateTitle}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StateMessage}" Style="{StaticResource Quiet}"/>
                <Button Content="{Binding StateAction}" Command="{Binding StartCommand}" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RuleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StateAction}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Se ve a qué dominios e IP se conecta cada proceso y cuántos bytes mueve. El contenido HTTPS va cifrado y no se muestra."
                           Style="{StaticResource Quiet}" FontSize="12" Margin="0,24,0,0"/>
            </StackPanel>

            <!-- Running, nothing chosen -->
            <TextBlock Grid.Column="2" Text="Elige un proceso de la lista para ver a dónde se conecta y cuánto descarga y envía.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRunning}" Value="True"/>
                                    <Condition Binding="{Binding HasSelection}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Running, a process chosen -->
            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRunning}" Value="True"/>
                                    <Condition Binding="{Binding HasSelection}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary -->
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0" KeyboardNavigation.TabNavigation="Once">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="1 min"
                                         IsChecked="{Binding RangeMinutes, Converter={StaticResource Equals}, ConverterParameter=1}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="5 min"
                                         IsChecked="{Binding RangeMinutes, Converter={StaticResource Equals}, ConverterParameter=5}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="AHORA" Style="{StaticResource Head}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Style="{StaticResource DownMarkPath}"/><TextBlock Text="{Binding DownText}" FontWeight="Bold" Margin="0,0,12,0"/>
                                <Path Style="{StaticResource UpMarkPath}"/><TextBlock Text="{Binding UpText}" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DESDE QUE LO MIRAS" Style="{StaticResource Head}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Style="{StaticResource DownMarkPath}"/><TextBlock Text="{Binding TotalDownText}" FontWeight="Bold" Margin="0,0,12,0"/>
                                <Path Style="{StaticResource UpMarkPath}"/><TextBlock Text="{Binding TotalUpText}" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Inspected.Name}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GroupDetail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    ToolTip="Consumo acumulado desde que se inició la inspección.">
                            <TextBlock Text="TOTAL" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Path Style="{StaticResource DownMarkPath}"/>
                            <TextBlock Text="{Binding Inspected.TotalDownText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Path Style="{StaticResource UpMarkPath}"/>
                            <TextBlock Text="{Binding Inspected.TotalUpText}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="El proceso terminó; se conservan sus datos." FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding ProcessGone, Converter={StaticResource Shown}}"/>
                    </StackPanel>
                </DockPanel>

                <!-- The group's own tide -->
                <c:TideChart Grid.Row="1" Samples="{Binding Samples}" Revision="{Binding Revision}" WindowSeconds="{Binding WindowSeconds}"/>

                <!-- Tabs and their tools -->
                <DockPanel Grid.Row="2" Margin="0,12,0,8" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Tab" Content="Destinos"
                                     IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Destinations}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Tab" Content="Registro"
                                     IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Log}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource OnDestinations}" KeyboardNavigation.TabNavigation="Once">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Más bajada"
                                     IsChecked="{Binding SortBy, Converter={StaticResource Equals}, ConverterParameter=Down}"
                                     Command="{Binding SetSortCommand}" CommandParameter="Down"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Más subida"
                                     IsChecked="{Binding SortBy, Converter={StaticResource Equals}, ConverterParameter=Up}"
                                     Command="{Binding SetSortCommand}" CommandParameter="Up"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Recientes"
                                     IsChecked="{Binding SortBy, Converter={StaticResource Equals}, ConverterParameter=Recent}"
                                     Command="{Binding SetSortCommand}" CommandParameter="Recent"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource OnLog}">
                        <Grid Width="150" Margin="0,0,8,0">
                            <TextBox Style="{StaticResource RuleTextBox}" FontSize="13" Padding="6,3"
                                     Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar registro"/>
                            <TextBlock Text="Filtrar" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Command="{Binding TogglePauseCommand}" Margin="0,0,4,0" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RuleButton}">
                                    <Setter Property="Content" Value="Pausar"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Content" Value="Reanudar"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource RuleButton}" Content="Limpiar" Command="{Binding ClearLogCommand}" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Style="{StaticResource RuleButton}" Content="Copiar" Command="{Binding CopyLogCommand}" Margin="0,0,4,0" Padding="10,4"/>
                        <Button Style="{StaticResource RuleButton}" Content="Guardar…" Command="{Binding SaveLogCommand}" Padding="10,4"/>
                    </StackPanel>
                </DockPanel>

                <!-- Destinations -->
                <DockPanel Grid.Row="3" Style="{StaticResource OnDestinations}">
                    <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="76"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DESTINO" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="1" Text="DIRECCIÓN" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="2" Text="PROTO" Style="{StaticResource Head}"/>
                        <TextBlock Grid.Column="3" Text="BAJADO" Style="{StaticResource Head}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="SUBIDO" Style="{StaticResource Head}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="ÚLTIMO" Style="{StaticResource Head}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource RuleStrongBrush}"/>
                    <Grid>
                        <TextBlock Text="Sin actividad de red todavía.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDestinations}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox Style="{StaticResource PlateList}" ItemContainerStyle="{StaticResource PlateListItem}"
                                 ItemsSource="{Binding Destinations}" AutomationProperties.Name="Destinos">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="76"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayHost}" ToolTip="{Binding DisplayHost}" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Host}" Value="">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Endpoint}" FontSize="13"
                                                   Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Proto}" FontSize="12" Style="{StaticResource RowMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DownText}" FontSize="13" FontWeight="Bold" Style="{StaticResource RowText}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding UpText}" FontSize="13" Style="{StaticResource RowText}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{Binding LastText}" Style="{StaticResource RowMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <!-- Verbose log -->
                <Border Grid.Row="3" Style="{StaticResource OnLog}" Background="{DynamicResource Ground2Brush}"
                        BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                    <ListBox x:Name="LogList" Style="{StaticResource PlateList}" ItemsSource="{Binding LogView}"
                             SelectionMode="Extended" FontFamily="{StaticResource LogFace}" FontSize="12"
                             AutomationProperties.Name="Registro">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlateListItem}">
                                <Setter Property="Padding" Value="8,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource RowMuted}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="DNS">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="CIERRA">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="INFO">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Wraps rather than trims: the destination and the honesty note must never be cut. -->
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource RowText}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
