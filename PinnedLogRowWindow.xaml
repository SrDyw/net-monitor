<Window x:Class="NetMonitor.PinnedLogRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="300" Height="24"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource ChartFace}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Always deep water, like the watermark it sits beside. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Night.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="PlateBrush" Color="#D90B1F33"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource PlateBrush}" Padding="10,4"
            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Counter}" Width="42" TextAlignment="Right"
                       Margin="0,0,8,0" FontFamily="{StaticResource LogFace}" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource LogFace}" FontSize="11"
                       Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </DockPanel>
    </Border>
</Window>
